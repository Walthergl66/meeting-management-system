# Entorno del stack Docker para CI: es el ÚNICO .env versionado, porque no
# contiene secretos (el JWT_SECRET es un valor de usar y tirar) y el compose
# necesita un archivo real que interpolar.
#
# Referencia local del backend: backend/.env.example (el .env de cada proyecto
# está gitignorado y no se comparte entre backend y frontend).

# ─── PostgreSQL del stack (servicio `db`) ─────────────────────────────────────
POSTGRES_USER=meetflow
POSTGRES_PASSWORD=meetflow
POSTGRES_DB=meetflow
DATABASE_URL_DOCKER=postgresql://meetflow:meetflow@db:5432/meetflow?schema=public

# ─── API (servicio `api`) ─────────────────────────────────────────────────────
# Solo para CI: no es un secreto real (mínimo 16 caracteres que exige Joi).
JWT_SECRET=ci-jwt-secret-value-at-least-32-chars
CORS_ORIGINS=http://localhost:3001

# ─── Web (servicio `web`) ─────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3000
