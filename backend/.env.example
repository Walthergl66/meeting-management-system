# ─── Aplicación ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=

# ─── Base de datos ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://meetflow:meetflow@localhost:5432/meetflow?schema=public

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=cambia-este-secreto-por-uno-de-al-menos-32-caracteres
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=cambia-este-secreto-refresco-min-32-caracteres
REFRESH_TOKEN_EXPIRES_IN=7d

# ─── CORS / tiempo real ───────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3001
FRONTEND_URL=http://localhost:3001

# ─── Storage (FASE 13) ────────────────────────────────────────────────────────
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
AWS_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── Email ────────────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@meetflow.local

# ─── Asistente IA (FASE 15) ───────────────────────────────────────────────────
GEMINI_API_KEY=
