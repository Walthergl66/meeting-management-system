# Copia este archivo a .env y ajusta los valores: .env está en .gitignore.
#
# Es el archivo que lee ConfigModule de NestJS (busca primero en la raíz del
# repo y luego en backend/) y el que docker-compose.yml interpola para sus
# variables. Cada bloque indica quién consume la variable.

# ─── Aplicación ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Declarado y validado, pero hoy no aplica prefijo global: la API cuelga de
# la raíz (/health, /api/docs). Reservado para un futuro setGlobalPrefix.
API_PREFIX=

# ─── Base de datos ────────────────────────────────────────────────────────────
# Desarrollo (host): la usa Prisma y los scripts pnpm db:* (dotenv -e ../.env)
DATABASE_URL=postgresql://meetflow:meetflow@localhost:5432/meetflow?schema=public
# Dentro de la red de docker compose (servicio `db`); la interpolan los servicios
# `migrate` y `api` de docker-compose.yml
DATABASE_URL_DOCKER=postgresql://meetflow:meetflow@db:5432/meetflow?schema=public

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Obligatorios, mínimo 16 caracteres (Joi min(16) en env.validation.ts)
JWT_SECRET=cambia-este-secreto-por-uno-de-al-menos-32-caracteres
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=cambia-este-secreto-refresco-min-32-caracteres
REFRESH_TOKEN_EXPIRES_IN=7d

# ─── CORS / tiempo real ───────────────────────────────────────────────────────
# Lista separada por comas que acepta CORS_ORIGINS (peticiones HTTP)
CORS_ORIGINS=http://localhost:3001
# Origen permitido por el gateway de WebSocket (/realtime) — WebSocketOptions
FRONTEND_URL=http://localhost:3001

# ─── Storage (FASE 13) ────────────────────────────────────────────────────────
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
AWS_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── Email ────────────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@meetflow.local

# ─── Asistente IA (FASE 15) ───────────────────────────────────────────────────
# Sin valor, POST /assistant/chat responde 503 con un mensaje claro.
GEMINI_API_KEY=

# ─── PostgreSQL de docker compose (servicio `db`) ─────────────────────────────
POSTGRES_USER=meetflow
POSTGRES_PASSWORD=meetflow
POSTGRES_DB=meetflow
